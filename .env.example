# Geheimer Schlüssel für Login-Sitzungen. Lang und zufällig wählen, z. B.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Öffentliche Adresse der App (für Stripe-Weiterleitungen)
APP_URL=http://localhost:3000

# Diese E-Mail-Adressen dürfen Videos hochladen (Komma-getrennt).
# Leer lassen: dann wird das erste registrierte Konto zum Creator.
CREATOR_EMAILS=

# Wie viele Videos man gratis sehen darf
FREE_VIDEOS=4

# Stripe. Ohne diese Werte läuft die Bezahlung im Testmodus (Abo wird ohne Zahlung freigeschaltet).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Wo Datenbank und Videos gespeichert werden
DATA_DIR=./data
